# syntax=docker/dockerfile:1

# QuantSim -- the React bundle, and the server that fronts the whole stack.
#
# Build from the REPO ROOT, like Dockerfile.service, so one .dockerignore
# governs both:
#   docker build -f infra/docker/Dockerfile.frontend -t quantsim-frontend .

ARG NODE_VERSION=22

FROM node:${NODE_VERSION} AS build

WORKDIR /src

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# No VITE_API_BASE_URL, and its absence is the point.
#
# Step 25 passed it as a build argument and needed an `env -u` branch, because
# Vite bakes import.meta.env.* into the bundle and `??` does not fall back on
# an empty string. Step 26 made the base URL relative, so there is no host to
# bake and nothing to get wrong. Anything that reintroduces this argument is
# welding the image to one environment again.
RUN npm run build

# Caddy, not nginx, and it does both jobs: serves this bundle and proxies the
# API to the gateway. See infra/docker/Caddyfile for why one server and one hop
# rather than nginx with Caddy in front of it.
FROM caddy:2-alpine

# Strip the file capability from the binary.
#
# caddy ships with cap_net_bind_service=+ep so it can bind 80 and 443 as a
# non-root user. Combined with no-new-privileges, that makes the binary
# UNEXECUTABLE: the kernel refuses to exec a file carrying capabilities when
# NoNewPrivs is set, because granting them would be exactly the escalation the
# flag exists to prevent. The container crash-loops on
# `exec /usr/bin/caddy: operation not permitted`, which names neither cause.
#
# It is not needed. The Caddyfile puts HTTP and HTTPS on high ports and the
# host publishes 80 and 443 onto them, so nothing inside this container ever
# binds a privileged port. Keeping the sandbox and dropping the capability is
# the right way round; the alternative is dropping no-new-privileges to make an
# unused privilege work.
RUN apk add --no-cache libcap     && setcap -r /usr/bin/caddy     && apk del libcap

COPY infra/docker/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /usr/share/caddy

EXPOSE 5173
