# syntax=docker/dockerfile:1

# QuantSim -- the React bundle, built once and served by nginx.
#
# Build from the REPO ROOT, like Dockerfile.service, so one .dockerignore
# governs both:
#   docker build -f infra/docker/Dockerfile.frontend -t quantsim-frontend .

ARG NODE_VERSION=22

FROM node:${NODE_VERSION} AS build

WORKDIR /src

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# VITE_API_BASE_URL is baked into the bundle here and cannot be changed later.
# Vite substitutes import.meta.env.* at build time, so setting this variable on
# a running container does nothing at all -- while looking exactly like it
# should work. SPEC.md 2.9.
#
# The `env -u` branch is not defensive noise. The app reads
#
#     import.meta.env.VITE_API_BASE_URL ?? 'http://localhost:8080'
#
# and ?? falls back on null/undefined only. An empty string is neither, so
# exporting VITE_API_BASE_URL="" would compile the base URL to "" and turn
# every API call into a same-origin request to the nginx serving this bundle.
# Unset and empty have to stay different things.
ARG VITE_API_BASE_URL
RUN if [ -n "$VITE_API_BASE_URL" ]; then \
        VITE_API_BASE_URL="$VITE_API_BASE_URL" npm run build; \
    else \
        env -u VITE_API_BASE_URL npm run build; \
    fi

# nginx-unprivileged rather than nginx: it runs as uid 101 with no setuid step,
# which is what lets the container keep cap_drop: ALL and a read-only root
# filesystem. Stock nginx drops privileges itself and needs CAP_SETUID to do
# it.
FROM nginxinc/nginx-unprivileged:1.29-alpine

COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 5173
