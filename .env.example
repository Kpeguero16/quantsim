# There are two ways to run this project and this file serves both, but not
# identically. Read this before changing a URL below.
#
#   make run-*        the services as host processes. They read this file
#                     through the Makefile, so every URL below is used as
#                     written and every one of them says "localhost".
#
#   make stack-up     the services as containers. localhost inside a container
#                     is that container, so docker-compose.yml IGNORES the URLs
#                     below and builds its own from the compose service names.
#                     It reads only the parts that travel: the credentials, the
#                     API keys, and the rate-limit knobs.
#
# So DATABASE_URL, REDIS_URL and the five *_SERVICE_URL entries are host-loop
# settings. Changing one of them does not change what the containers do.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# POSTGRES_PASSWORD is interpolated into a connection string, both in the
# DATABASE_URL below and by docker-compose.yml. A password containing @ : / or
# # produces a URL that parses wrong or not at all, and the error names the
# host rather than the password. Pick one without them.

# Full connection string for migrate CLI and Go (match user/password/db above)
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/postgres?sslmode=disable

# The database the APPLICATION lives in, for the container stack only.
#
# This exists because POSTGRES_DB is not that database and cannot be used as
# it. POSTGRES_DB names the database the postgres image creates on first boot;
# DATABASE_URL names the one the services actually use, and on the reference
# development machine those are deliberately DIFFERENT -- POSTGRES_DB=quantsim
# is an empty decoy and the data lives in `postgres`. README.md and
# docs/PHASE2_CHECKLIST.md both record that on purpose.
#
# Compose cannot pull a database name out of DATABASE_URL, so it takes this
# one, defaulting to `postgres` to match the line above. Leave it unset unless
# you move the application to a differently-named database, in which case set
# it here AND in DATABASE_URL.
#
# Getting this wrong does not look like a failure. The migrate one-shot creates
# the schema in whatever database it is pointed at, so registration returns
# 201, orders fill, and the only symptom is a report that finds no history.
# That is not hypothetical: it is what the first run of the container stack did.
# POSTGRES_APP_DB=postgres

# Redis. Used by market-data for the price cache/pub-sub, and since Step 13
# by auth for refresh-token revocation (keys prefixed revoked:, so the two
# can never collide on the same DB).
REDIS_URL=redis://localhost:6379/0

# pgAdmin (optional). Only starts with the "tools" profile -- plain
# `make docker-up` does not run it:
#   docker compose --profile tools up -d
# Both have working defaults (admin@quantsim.local / admin), so these are
# only needed to override them. Bound to 127.0.0.1:5050.
PGADMIN_EMAIL=admin@quantsim.local
PGADMIN_PASSWORD=change_me_if_you_use_pgadmin

# JWT signing
JWT_SECRET=your_jwt_secret_here

# Alpaca market data
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Service URLs (gateway)
# Where the gateway forwards each route prefix. Defaults match the ports each
# service already uses, so these only need setting if you move one.
#
# Since Step 26 the browser never talks to the gateway directly -- Caddy does,
# from inside the container network -- so the gateway itself is not published
# by the container stack at all. These are still what the `make run-*` loop
# uses.
AUTH_SERVICE_URL=http://localhost:8081
MARKET_DATA_SERVICE_URL=http://localhost:8082
TRADING_ENGINE_SERVICE_URL=http://localhost:8083
BACKTESTING_SERVICE_URL=http://localhost:8084
INSIGHTS_SERVICE_URL=http://localhost:8085

# Trading engine (Step 14, REDIS_URL added in Step 24)
#
# DATABASE_URL, JWT_SECRET and BIND_ADDR are the shared ones above;
# MARKET_DATA_SERVICE_URL is reused as-is, since the trading engine calls
# market-data directly for the fill price rather than through the gateway --
# the gateway wants an end-user JWT, which one internal service calling
# another does not have.
#
# REDIS_URL is OPTIONAL and buys exactly one thing: when an order fills, the
# placing user's cached portfolio report is deleted, so GET /insights/portfolio
# reflects the trade they just made instead of figures computed before it.
#
# Orders place identically without it. What degrades is only that report, which
# can then lag a fill by up to its five-minute cache TTL -- the behaviour that
# existed before Step 24. Unset is a supported configuration, and the service
# says so at boot rather than leaving a reader to wonder why their own trade is
# missing from their report.
#
# It is the same Redis every other service uses. Keys stay apart by prefix
# convention alone, and this service touches exactly one: insights:{user_id},
# whose format lives in pkg/cachekeys because ai-insights writes what this
# service deletes.
#
# It listens on 8083 by default (auth=8081, market-data=8082). Do NOT put
# PORT=8083 in .env: the Makefile exports this file to every target, so a PORT
# set here would move all four services onto the same port. Override it per
# process instead:  PORT=9083 make run-trading-engine

# Backtesting engine (Step 16)
#
# Same shape as trading engine above: no variables of its own beyond the
# shared ones, and it also calls market-data directly (for historical bars
# rather than a live price) rather than through the gateway.
#
# It listens on 8084 by default. Do NOT put PORT=8084 in .env, for the same
# reason as above -- override per process instead:
#   PORT=9084 make run-backtesting

# AI insights (Step 20)
#
# It needs no variables of its own, and notably no DATABASE_URL: it owns no
# tables (SPEC.md Step 20 2.9). JWT_SECRET and BIND_ADDR are the shared ones
# above. TRADING_ENGINE_SERVICE_URL and MARKET_DATA_SERVICE_URL are reused
# as-is -- it calls both directly rather than through the gateway, forwarding
# the caller's own JWT on the trading-engine hop because /trading/* is
# authenticated at trading-engine itself.
#
# It listens on 8085 by default. Same PORT caveat as above -- override per
# process instead:  PORT=9085 make run-ai-insights

# --- Step 26: one origin, and what has to know about it -----------------
#
# The browser talks to ONE origin. Caddy serves the compiled frontend and
# proxies /auth, /market-data, /trading, /backtests and /insights to the
# gateway, so the bundle contains no API host and nothing crosses origins.
#
# SITE_ADDRESS is what Caddy listens on, and whether it is a hostname is what
# decides whether Caddy issues a certificate. Container stack only; the Vite
# dev server has its own proxy in frontend/vite.config.ts.
#   :5173                             local, plain HTTP, no certificates
#   quantsim.khalilpeguero.me         deployed, automatic Let's Encrypt
SITE_ADDRESS=:5173

# The deployed hostname, used by docker-compose.prod.yml for both SITE_ADDRESS
# and the gateway's CORS origin. Unset locally.
# DOMAIN=quantsim.khalilpeguero.me

# The one hop whose X-Forwarded-For the gateway may believe, as CIDRs.
#
# EMPTY BY DEFAULT, and that is correct with nothing in front of the gateway.
# Behind a proxy it is not: r.RemoteAddr becomes the proxy's address on every
# request, so the per-IP rate limiter works perfectly on ONE key for everybody
# -- 100 requests per 15 minutes shared by the whole internet, arriving as
# "login is broken" rather than as a rate limit.
#
# docker-compose.yml sets this to the frontend container's fixed address. Set
# it here only when running the gateway on the host behind something.
#
# It is correct for exactly ONE hop. Putting another proxy in front (an ALB,
# Cloudflare) needs services/gateway/internal/middleware/clientip.go revisited
# first -- the limiter would start keying on the inner proxy, silently.
# TRUSTED_PROXIES=

# Which Origin the gateway's CORS middleware accepts. Defaults to the Vite dev
# server. Inert while everything is same-origin, and it still has to be right:
# this is what would refuse a genuine cross-origin request.
# CORS_ALLOWED_ORIGIN=http://localhost:5173

# Escape hatch for pointing a local frontend at a remote API. Leave it unset.
#
# Vite substitutes import.meta.env.* at BUILD time, so a value here is compiled
# into the bundle: the image and its environment become welded together, and
# setting it on a running container does nothing while looking exactly like it
# should work. Step 26 made the app's URLs relative so there is nothing to set.
# VITE_API_BASE_URL=

# Auth rate limiting (gateway)
# Applies to /auth/* only -- /healthz and the authenticated routes are not
# limited. Every value below is the default, so none of these need setting.
#
# Counters are held in the gateway process, not in Redis. That is correct
# while exactly one gateway runs; two instances would each keep their own,
# doubling the effective limit. See SPEC.md 2.1 and docs/deferred-tuning.md.
RATE_LIMIT_IP_REQUESTS=100
RATE_LIMIT_IP_WINDOW=15m

# Consecutive failed logins before backoff starts, and the ceiling it doubles
# up to. Backoff is per account and always decays -- there is no lockout, so
# no unlock path is needed and nobody can freeze someone else's account.
RATE_LIMIT_LOGIN_FAILURES=5
RATE_LIMIT_LOGIN_MAX_BACKOFF=15m

# Escape hatch: set to "false" to disable auth rate limiting entirely, so a
# bug in a control sitting in front of login cannot become an outage with no
# way out. The gateway logs a warning at boot whenever it is off.
RATE_LIMIT_ENABLED=true

# Listen address for every Go service. Defaults to 127.0.0.1 so the auth and
# market-data services -- which have no authentication of their own and expect
# the gateway to enforce it -- are not reachable from the network. Only set
# this to 0.0.0.0 when running behind a real network boundary (a container
# network, a security group), never on a laptop on shared wifi.
BIND_ADDR=127.0.0.1

# --- AI insights: narrative generation (Step 21) -------------------------
# Optional, like REDIS_URL for this service. Without a key the report
# endpoint is unaffected and GET /insights/portfolio/narrative returns
# 200 with narrative: null and a reason. The service logs the degradation
# at boot rather than refusing to start.
ANTHROPIC_API_KEY=
# Overridable for experimentation; echoed in every narrative response.
ANTHROPIC_MODEL=claude-opus-5
